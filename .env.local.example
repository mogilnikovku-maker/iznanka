# Supabase — возьмите значения в Dashboard → Project Settings → API
# Эти два ключа публичные (идут в браузер), это нормально: доступ ограничивает RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Базовый URL приложения (для редиректа magic-link).
# Локально — http://localhost:3000, на Vercel — https://ваш-домен.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
